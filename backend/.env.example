# Copie ce fichier en .env pour le développement local (déjà dans
# .gitignore, jamais commité) — .env n'est utile qu'en local : en
# production (Render), ces mêmes variables se règlent dans le dashboard
# Render (Environment) et/ou les secrets GitHub Actions (cf. .github/workflows/).

# --- Cœur Django ---
# True en local pour voir les erreurs détaillées. Absent ou False partout
# ailleurs (le code refuse même de démarrer en production sans
# DJANGO_SECRET_KEY explicite quand DEBUG=False).
DJANGO_DEBUG=True
# Obligatoire en production (DEBUG=False). Générer avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Domaines autorisés à servir l'app, séparés par des virgules (ex: vde.onrender.com).
DJANGO_ALLOWED_HOSTS=
# Origines autorisées à appeler l'API en CORS (ex: https://vde.pages.dev), séparées par des virgules.
DJANGO_CORS_ALLOWED_ORIGINS=
# Origines de confiance pour le CSRF de /admin/, séparées par des virgules.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Base publique du frontend — utilisée pour générer les URLs encodées dans les QR codes de pointage.
DJANGO_FRONTEND_URL=http://localhost:5173

# --- Base de données ---
# Format postgres://user:password@host:port/dbname — absent en local (utilise SQLite par défaut).
DATABASE_URL=

# --- Stockage des fichiers (Cloudinary) ---
# Absent en local (utilise le disque). Nécessaire en production : le disque
# de Render est éphémère.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Emails (Brevo, relais SMTP gratuit) ---
# Absent en local (les emails partent dans la console au lieu d'échouer).
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
DJANGO_DEFAULT_FROM_EMAIL=alertes@volailles-de-lest.local
# Destinataires des alertes métier quotidiennes (stock bas, mortalité...), séparés par des virgules.
DJANGO_ALERTES_EMAILS=
# Destinataires des emails d'erreur technique (exception serveur non gérée,
# erreur JS frontend) — séparés par des virgules. Vide = aucun email envoyé.
DJANGO_ADMINS_EMAILS=
