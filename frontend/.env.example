# Copie ce fichier en .env.local pour le développement local (déjà dans
# .gitignore). En production, cette variable est passée directement à la
# commande de build (cf. workflow de déploiement) :
#   VITE_API_BASE_URL=https://vde.onrender.com/api npm run build

# Absent en local : retombe sur http://localhost:8010/api (backend Django lancé en local).
VITE_API_BASE_URL=
